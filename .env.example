# Build-time (NEXT_PUBLIC_* is inlined into the client bundle by `next build`).
# Copy to .env before running `npm run cf-build` / `npm run deploy:cf`.

# Origin of the agent backend Worker (Worker B: /api/agent/*, /api/sessions/*,
# /api/models). Leave empty to use same-origin relative "/api" paths.
NEXT_PUBLIC_AGENT_BASE_URL=https://pi-cf.bitter-fog-5f6d.workers.dev

# Synthetic working directory used for new sessions on Cloudflare Workers
# (no local filesystem / directory picker there). Defaults to /workspace.
NEXT_PUBLIC_CF_CWD=/workspace
